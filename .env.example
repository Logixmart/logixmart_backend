PORT=5001
NODE_ENV=development
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
# Prisma / Postgres (separate from Supabase Storage credentials).
# Local Docker example:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/logixmart?schema=public
# Supabase Session Pooler (Dashboard → Connect → Session pooler). Encode special chars in PASSWORD only (@ → %40).
# Username is often postgres.YOUR_PROJECT_REF (use the exact value from the Connect UI).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?schema=public
UPLOAD_DIR=uploads
API_BASE_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:3000

# Supabase Storage (images). Never commit real secrets.
# SUPABASE_SECRET_KEY is server-only (service role) — never expose to the frontend.
# user-images must exist and be PUBLIC (Storage → New bucket in the Dashboard).
# Verify with: npm run check:storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_IMAGE_BUCKET=user-images
# Private resumes only (never public). Do not put resumes in user-images.
SUPABASE_RESUME_BUCKET=private-resumes

# --- Email notifications (SMTP) ---
# Provider NOT yet confirmed. Clue only: MX for logixmart.com points to Google
# Workspace (smtp.google.com / _spf.google.com). This indicates inbound routing,
# not proof of the outbound SMTP host. Obtain the exact host, port, TLS mode,
# username and password/App Password from the company email administrator and
# fill these in. Never commit real credentials; SMTP_* is backend-only and must
# never be exposed to the React frontend.
#
# SMTP_HOST is a placeholder, not a guess.
SMTP_HOST=<smtp-host-from-email-admin>
# 587 = STARTTLS (SMTP_SECURE=false). 465 = implicit TLS (SMTP_SECURE=true).
# Confirm the correct port/TLS mode with the provider.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password-or-app-password>
# Sender address. Must be an address the SMTP account is authorized to send as.
MAIL_FROM=<verified-sender@logixmart.com>
# Recipients (separate per notification type).
HR_NOTIFICATION_EMAIL=<hr-notification-email>
CLIENT_QUERY_EMAIL=<client-query-email>
# Optional: admin panel base URL, used to link a job application in the HR
# email. Leave blank to omit the link.
ADMIN_APP_URL=
