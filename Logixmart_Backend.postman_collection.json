    {
      "name": "Admin Authentication",
      "item": [
        {
          "name": "Admin Login - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.token).to.not.be.undefined;",
                  "    // Save token as a environment or collection variable for reuse",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@logixmart.com\",\n    \"password\": \"LogixmartAdmin2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "description": "Authenticates the admin user and returns a JWT token."
          },
          "response": []
        },
        {
          "name": "Admin Login - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Response returns failure status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.message).to.eql(\"Invalid email or password\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@logixmart.com\",\n    \"password\": \"WrongPassword!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "description": "Verifies that incorrect credentials fail authentication with 401."
          },
          "response": []
        },
        {
          "name": "Admin Login - Missing Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response returns validation message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.message).to.eql(\"Email and password are required\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@logixmart.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "description": "Verifies that missing password fails validation with 400."
          },
          "response": []
        },
        {
          "name": "Admin Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "logout"
              ]
            },
            "description": "Logs out the admin and prompts the client to discard the session token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blogs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs"
              ]
            },
            "description": "Retrieves list of all blogs, sorted by newest first."
          },
          "response": []
        },
        {
          "name": "Create Blog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains created blog details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.id).to.not.be.undefined;",
                  "    // Save blog ID for subsequent requests",
                  "    pm.collectionVariables.set(\"blog_id\", jsonData.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "My First Logixmart Blog",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "This is a detailed description of the first blog on the platform. It talks about modern logistics technologies.",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/blogs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs"
              ]
            },
            "description": "Creates a new blog post. Requires admin authorization. Image must be uploaded via the 'image' file field."
          },
          "response": []
        },
        {
          "name": "Get Blog Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/blogs/{{blog_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs",
                "{{blog_id}}"
              ]
            },
            "description": "Retrieves the details of a single blog by its ID."
          },
          "response": []
        },
        {
          "name": "Update Blog",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "My Updated Logixmart Blog",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "This description has been updated using the PUT admin API.",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/blogs/{{blog_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs",
                "{{blog_id}}"
              ]
            },
            "description": "Updates details of a blog post. Requires admin authorization. Title, description and image are all optional in this request."
          },
          "response": []
        },
        {
          "name": "Delete Blog",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/blogs/{{blog_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs",
                "{{blog_id}}"
              ]
            },
            "description": "Deletes the blog and cleans up its image from the server. Requires admin authorization."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "blog_id",
      "value": "",
      "type": "string"
    }
  ]
}
